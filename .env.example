# ── משתנה בנייה של הפרונט (Vite) ─────────────────────────────────
# מצב הדגמה: true = לא קורא לשרת אלא מחזיר צמח לדוגמה, לבדיקת הממשק בלי מפתח.
VITE_MOCK_IDENTIFY=false

# ── מפתחות השרת (פונקציית Cloudflare) ────────────────────────────
# אלה נשמרים בצד השרת בלבד. בפיתוח מקומי הם נכנסים לקובץ .dev.vars
# (ראו .dev.vars.example), ובפרודקשן ל-Cloudflare Pages → Environment variables.
# PLANTNET_API_KEY=...
