# ── מפתח Pl@ntNet (חינמי, לא-מסחרי) ─────────────────────────────
# נרשמים ומקבלים מפתח כאן: https://my.plantnet.org/
# המפתח נשמר רק בצד השרת (serverless function) ולא נחשף בדפדפן.
PLANTNET_API_KEY=your_plantnet_key_here

# ── מצב הדגמה (אופציונלי) ────────────────────────────────────────
# true = לא קורא ל-Pl@ntNet אלא מחזיר צמח לדוגמה, כדי לבדוק את הממשק בלי מפתח.
VITE_MOCK_IDENTIFY=false

# ── שדרוג אופציונלי: Claude Vision (בתשלום, כבוי כברירת מחדל) ─────
# אם רוצים תיאורים עשירים במיוחד בעברית דרך Claude, ממלאים מפתח ומדליקים את הדגל.
# ANTHROPIC_API_KEY=
# USE_CLAUDE_VISION=false
